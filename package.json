{
  "name": "nextjs-mdx-playground",
  "description": "Experimenting with Next.js + MDX 🧑‍🔬",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "check": "ncu --interactive --format group",
    "check:pre": "npm run check -- --target greatest",
    "build": "next build",
    "dev": "next dev",
    "fix": "npm run lint:fix && npm run format:fix",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:staged": "lint-staged",
    "start": "next start",
    "test": "npm run lint && npm run format && npm run types",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.0.7",
    "@types/mdx": "2.0.13",
    "next": "16.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "git": {
    "pre-commit": "lint:staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vercel/git-hooks": "1.0.0",
    "autoprefixer": "10.4.22",
    "lint-staged": "16.2.7",
    "npm-check-updates": "19.1.2",
    "oxlint": "1.31.0",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
