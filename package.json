{
  "name": "nextjs-mdx-playground",
  "description": "Experimenting with Next.js + MDX 🧑‍🔬",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "check": "npm-check -u",
    "build": "next build --turbopack",
    "dev": "next dev --turbopack",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "start": "next start",
    "test": "npm run format:check && npm run lint && tsc"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "15.5.4",
    "@types/mdx": "2.0.13",
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "git": {
    "pre-commit": "lint:staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vercel/git-hooks": "1.0.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.4",
    "lint-staged": "16.2.3",
    "npm-check": "6.0.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3"
  }
}
